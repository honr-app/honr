# honr agent sandbox = the OpenShell base image + a Rust toolchain + a warm
# dependency cache.
#
# Why this exists: the base image ships node, git, gh and claude but no cargo,
# so an agent cannot build or test honr. Installing rustup per card would cost
# minutes of wall-clock and real Vertex spend on every run, and would require
# opening three more egress destinations permanently. Baking it means
# crates.io never has to be reachable from an agent sandbox at all.
#
# Build from the REPO ROOT, so Cargo.lock and web/package-lock.json are in context:
#   docker build -f sandbox/Containerfile -t honr-sandbox:latest .
#
# Then pair it with the worker board-profile policy companion entries — see the
# note at the bottom (and src/seed_policies.rs for the empty-catalog seed).

FROM ghcr.io/nvidia/openshell-community/sandboxes/base:latest

USER root

# Cockpit MCP reaches the agent's stdio MCP client through `socat` on a
# local Unix socket (cockpit_mcp_tunnel::AGENT_SOCK_PATH). Not `nc`: the
# base image's OpenBSD-netcat build accepts a UDS connection fine but never
# forwards bytes written to its stdin *after* accept out to the socket —
# exactly the relay->client direction serve_server's responses need. Layer
# lives after the warm caches below so re-running this apt-get does not
# invalidate the expensive rustup/cargo/npm layers.

# Match the host toolchain. Cargo.toml declares rust-version = "1.88", so this
# only needs to be >= that; pinning keeps sandbox builds reproducible.
ARG RUST_VERSION=1.97.1

# Toolchain lives outside $HOME because /sandbox is the agent's writable
# workdir and gets overlaid at runtime — anything installed there would vanish.
# CARGO_TARGET_DIR is shared across agent checkouts under /sandbox/repo so
# precompiled debug deps from the warm step are reused (GHA rust-cache analog).
ENV RUSTUP_HOME=/opt/rust \
    CARGO_HOME=/opt/cargo \
    CARGO_TARGET_DIR=/opt/cargo-target \
    NPM_CONFIG_CACHE=/opt/npm-cache \
    PATH=/opt/cargo/bin:$PATH

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
      | sh -s -- -y --no-modify-path --profile minimal \
           --default-toolchain "${RUST_VERSION}" \
           --component clippy \
 && cargo --version && clippy-driver --version

# Bake Google Antigravity CLI (agy) into the image alongside claude
RUN curl -fsSL https://antigravity.google/cli/install.sh | bash \
 && (mv /root/.local/bin/agy /usr/local/bin/agy 2>/dev/null || cp ~/.local/bin/agy /usr/local/bin/agy 2>/dev/null || true) \
 && chmod 0755 /usr/local/bin/agy 2>/dev/null || true

# Bake Cursor Agent CLI. Install lands under $HOME/.local; move under /opt so
# the sandbox user's /sandbox HOME overlay does not hide it, and put a stable
# /usr/local/bin/agent on the default PATH (exec env does not inherit image ENV).
RUN curl -fsSL https://cursor.com/install | bash \
 && mkdir -p /opt/cursor-agent \
 && cp -a /root/.local/share/cursor-agent/. /opt/cursor-agent/ \
 && AGENT_BIN="$(find /opt/cursor-agent/versions -type f -name cursor-agent | sort | tail -1)" \
 && test -n "$AGENT_BIN" \
 && ln -sfn "$AGENT_BIN" /usr/local/bin/agent \
 && ln -sfn "$AGENT_BIN" /usr/local/bin/cursor-agent \
 && chmod -R a+rX /opt/cursor-agent \
 && /usr/local/bin/agent --version

# Bake OpenCode CLI. Installer writes $HOME/.opencode/bin; relocate under /opt
# and expose /usr/local/bin/opencode on the default PATH (same ENV caveat).
RUN curl -fsSL https://opencode.ai/install | bash -s -- --no-modify-path \
 && mkdir -p /opt/opencode \
 && cp -a /root/.opencode/. /opt/opencode/ \
 && test -x /opt/opencode/bin/opencode \
 && ln -sfn /opt/opencode/bin/opencode /usr/local/bin/opencode \
 && chmod -R a+rX /opt/opencode \
 && /usr/local/bin/opencode --version

# ---- rustup shims & environment --------------------------------------------

# The toolchain must work from ANY shell, not just one that inherited our env.
#
# `ENV` here does not reach `openshell sandbox exec`, and passing PATH via
# --env is not enough either: the agent runs its own tool calls in subshells
# that do not necessarily carry it. The observed failure was
# `timeout: failed to run command 'cargo': No such file or directory` (exit
# 127) — the agent simply could not see cargo, on a card whose whole job is to
# build this project.
#
# Wrapper scripts in /usr/local/bin (always on the default PATH) that set
# RUSTUP_HOME and CARGO_HOME themselves. Plain symlinks would not do: the
# binaries are rustup shims and fail with "could not choose a version of cargo
# to run" when RUSTUP_HOME is unset.
RUN for b in cargo rustc rustup clippy-driver cargo-clippy cargo-fmt rustfmt; do \
      printf '#!/bin/sh\nexport RUSTUP_HOME=/opt/rust CARGO_HOME=/opt/cargo CARGO_TARGET_DIR=/opt/cargo-target\nexec /opt/cargo/bin/%s "$@"\n' "$b" \
        > "/usr/local/bin/$b" && chmod 0755 "/usr/local/bin/$b"; \
    done \
 && printf 'export RUSTUP_HOME=/opt/rust\nexport CARGO_HOME=/opt/cargo\nexport CARGO_TARGET_DIR=/opt/cargo-target\nexport NPM_CONFIG_CACHE=/opt/npm-cache\nexport PATH=/opt/cargo/bin:$PATH\n' \
      > /etc/profile.d/rust.sh && chmod 0644 /etc/profile.d/rust.sh

# ---- warm dependency caches ------------------------------------------------
# Registry + precompiled debug target (GHA rust-cache analog). Without this
# every card cold-fetches crates.io and recompiles the world (or hangs when
# policy denies egress). Agents then `cargo build/test --offline --locked`
# against CARGO_TARGET_DIR=/opt/cargo-target. Rebuild when Cargo.lock / src /
# web/package-lock.json change materially.
WORKDIR /tmp/honr-warm
COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY migrations ./migrations
# include_str!("../sandbox/openshell/antigravity.yaml") from src/
COPY sandbox/openshell ./sandbox/openshell
RUN cargo build --locked \
 && cargo test --no-run --locked \
 && rm -rf /tmp/honr-warm

WORKDIR /tmp/honr-warm-web
COPY web/package.json web/package-lock.json ./
RUN npm ci --ignore-scripts \
 && rm -rf /tmp/honr-warm-web

# Cargo and npm both write to their caches during a build, so these must stay
# group-writable for the unprivileged `sandbox` user. Re-chmod after the warm
# steps above — build/ci create root-owned cache entries.
RUN mkdir -p /opt/cargo /opt/cargo-target /opt/npm-cache \
 && chmod -R a+rX /opt/rust \
 && chmod -R a+rwX /opt/cargo /opt/cargo-target /opt/npm-cache

RUN apt-get update \
 && apt-get install -y --no-install-recommends socat \
 && rm -rf /var/lib/apt/lists/*

USER sandbox
WORKDIR /sandbox

# ---- board profile policy companion changes -------------------------------
# OpenShell matches binary paths LITERALLY and does not follow the toolchain's
# own symlinks, so the worker sandbox profile (Settings → default) needs, at minimum:
#
#   filesystem_policy.read_write:  add /opt/cargo, /opt/cargo-target, /opt/npm-cache
#   filesystem_policy.read_only:   add /opt/rust
#
# and, only if you accept live dependency fetches rather than rebuilding this
# image, a network policy allowing index.crates.io / static.crates.io /
# registry.npmjs.org for /opt/cargo/bin/cargo and /usr/bin/npm. Leaving those
# closed is the stronger default: a cache miss then fails loudly at build time
# instead of silently widening what an agent can reach.
# Live board profiles do not auto-pick up seed edits — paste /opt/cargo-target
# into Settings → OpenShell → Profiles → default if the catalog already exists.
